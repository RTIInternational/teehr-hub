{
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "always",
            "source.organizeImports.ruff": "always"
        }
    },
    
    // Use Ruff for linting
    "ruff.configurationPreference": "filesystemFirst",
    "ruff.lint.enable": true,
    
    // Disable Flake8 extension - Ruff handles this
    "flake8.enabled": false,
    
    // Disable isort extension - Ruff handles import sorting
    "isort.check": false,
    
    // Disable Pylance type checking (optional - Ruff handles linting)
    "python.analysis.typeCheckingMode": "off",
    "files.associations": {
        "yaml.tpl": "yaml"
    },

    // Front end development
    "oxc.path.oxlint": "frontend/node_modules/.bin/oxlint",
    "oxc.path.tsgolint": "frontend/node_modules/.bin/tsgolint",
    "oxc.lint.run": "onType",
    
    "oxc.requireConfig": true,
    "oxc.configPath": "frontend/.oxlintrc.json",
    "oxc.disableNestedConfig": true,
    
    "oxc.typeAware": true,
    "oxc.tsConfigPath": "frontend/tsconfig.app.json",

    "[javascript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.tabSize": 2,
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.tabSize": 2,
    },
    "[typescript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.tabSize": 2,
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.tabSize": 2,
    },
    "[css]": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.tabSize": 2,
    },
    "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "always",
    },
}
