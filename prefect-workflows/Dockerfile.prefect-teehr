FROM prefecthq/prefect:3.9.0-python3.12

ARG TEEHR_VERSION

# Use Docker BuildKit's automatic architecture detection
ARG TARGETARCH

# Use HTTPS apt mirrors so builds work when plain HTTP egress is blocked.
RUN sed -i 's|http://deb.debian.org/debian|https://deb.debian.org/debian|g; s|http://deb.debian.org/debian-security|https://deb.debian.org/debian-security|g' /etc/apt/sources.list.d/debian.sources

# Install Java 21 and other dependencies (matching Jupyter driver)
# We should switch to openjdk-17-jdk
RUN apt-get update && apt-get install -y \
    default-jdk \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install GDAL libraries for ARM64 (needed for rasterio compilation)
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        echo "Installing GDAL libraries for ARM64..." && \
        apt-get update && apt-get install -y \
        gdal-bin \
        libgdal-dev \
        libgeos-dev \
        libproj-dev \
        libspatialindex-dev \
        && rm -rf /var/lib/apt/lists/* && \
        echo "GDAL version: $(gdal-config --version)"; \
    else \
        echo "Skipping GDAL installation for x86_64 (not needed)"; \
    fi

# Install dependencies for gridded data ingestion via IceChunk + VirtualiZarr
# Allows for patch updates but blocks major/minor version changes
# xarray 2026.9 breaks icechunk 2.1's to_icechunk (it passes the removed `synchronizer` argument)
RUN pip install --no-cache-dir \
    "icechunk~=2.1.2" \
    "xarray<2026.9" \
    "virtual-tiff~=0.5.0" \
    "rioxarray~=0.23.0" \
    "tippecanoe~=2.72.0"

# Install TEEHR with GDAL compatibility for ARM64
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        echo "Installing TEEHR with constraints for ARM64..." && \
        export GDAL_CONFIG=/usr/bin/gdal-config && \
        export GDAL_VERSION=$(gdal-config --version) && \
        pip install --no-cache-dir "git+https://github.com/RTIInternational/teehr.git@${TEEHR_VERSION}"; \
    else \
        echo "Installing TEEHR normally for x86_64..." && \
        pip install --no-cache-dir "git+https://github.com/RTIInternational/teehr.git@${TEEHR_VERSION}"; \
    fi

# Patch the jars bundled in the pyspark wheel, which carry most of the image's
# fixable CVEs. Spark only runs in local mode here, against an Iceberg REST
# catalog, so the Hive/metastore stack (Hive, Derby, Thrift, ZooKeeper, legacy
# Jackson ASL), jline and the Scala Spark Connect REPL (connect-repl/) are unused
# and are removed. hive-storage-api stays because ORC depends on it. Netty,
# Jackson, Jersey, Bouncy Castle, aircompressor and snappy-java are swapped for
# later patch releases on the same lines Spark ships, so they stay drop-in.
# Not fixable here: CVEs shaded inside hadoop-client-runtime, spark-core and
# parquet-jackson, which need Hadoop/Spark/Parquet upgrades.
# Re-check these versions whenever pyspark is bumped.
ARG NETTY_VERSION=4.1.139.Final
ARG JACKSON_VERSION=2.18.12
ARG JERSEY_VERSION=3.0.18
ARG BCPROV_VERSION=1.86
ARG AIRCOMPRESSOR_VERSION=2.0.3
ARG SNAPPY_VERSION=1.1.10.12
RUN set -eu; \
    MVN=https://repo1.maven.org/maven2; \
    cd "$(python -c 'import os, pyspark; print(os.path.join(pyspark.__path__[0], "jars"))')"; \
    rm -rf connect-repl; \
    find . -name '*.jar' \( -name 'hive-*' ! -name 'hive-storage-api-*' -o -name 'spark-hive*' \
        -o -name 'derby*' -o -name 'libthrift-*' -o -name 'zookeeper*' -o -name 'jackson-*-asl-*' \
        -o -name 'jline-*' \) -print -delete; \
    old_netty=$(ls netty-common-*.jar | sed 's/^netty-common-\(.*\)\.jar$/\1/'); \
    for f in netty-*-"$old_netty"*.jar; do \
        artifact=${f%%-"$old_netty"*}; suffix=${f#"$artifact"-"$old_netty"}; \
        curl -fsSL -o "$artifact-$NETTY_VERSION$suffix" \
            "$MVN/io/netty/$artifact/$NETTY_VERSION/$artifact-$NETTY_VERSION$suffix"; \
        rm "$f"; \
    done; \
    for f in jackson-*-2.*.jar; do \
        artifact=${f%-2.*.jar}; \
        case "$artifact" in \
            jackson-core|jackson-databind|jackson-annotations) group=core ;; \
            jackson-dataformat-*) group=dataformat ;; \
            jackson-datatype-*) group=datatype ;; \
            jackson-module-*) group=module ;; \
            *) continue ;; \
        esac; \
        curl -fsSL -o "$artifact-$JACKSON_VERSION.jar" \
            "$MVN/com/fasterxml/jackson/$group/$artifact/$JACKSON_VERSION/$artifact-$JACKSON_VERSION.jar"; \
        rm "$f"; \
    done; \
    for f in jersey-*.jar; do \
        artifact=${f%-[0-9]*.jar}; \
        case "$artifact" in \
            jersey-container-*) group=containers ;; \
            jersey-hk2) group=inject ;; \
            *) group=core ;; \
        esac; \
        curl -fsSL -o "$artifact-$JERSEY_VERSION.jar" \
            "$MVN/org/glassfish/jersey/$group/$artifact/$JERSEY_VERSION/$artifact-$JERSEY_VERSION.jar"; \
        rm "$f"; \
    done; \
    rm bcprov-jdk18on-*.jar aircompressor-*.jar snappy-java-*.jar; \
    curl -fsSL -o "bcprov-jdk18on-$BCPROV_VERSION.jar" \
        "$MVN/org/bouncycastle/bcprov-jdk18on/$BCPROV_VERSION/bcprov-jdk18on-$BCPROV_VERSION.jar"; \
    curl -fsSL -o "aircompressor-$AIRCOMPRESSOR_VERSION.jar" \
        "$MVN/io/airlift/aircompressor/$AIRCOMPRESSOR_VERSION/aircompressor-$AIRCOMPRESSOR_VERSION.jar"; \
    curl -fsSL -o "snappy-java-$SNAPPY_VERSION.jar" \
        "$MVN/org/xerial/snappy/snappy-java/$SNAPPY_VERSION/snappy-java-$SNAPPY_VERSION.jar"

# Set JAVA_HOME statically based on build architecture
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-${TARGETARCH}
ENV PATH=$PATH:/usr/lib/jvm/java-21-openjdk-${TARGETARCH}/bin

# Create a user for UID 1000 so Java/Spark can resolve a home directory,
# and actually run as it. Everything that writes to the shared /data drive
# (JupyterHub singleuser, Spark executors, Prefect jobs) runs as uid 1000, so
# that files stay mutually deletable -- removing a file needs write on its
# parent directory, so a stray uid leaves data nobody can clean up. See
# RTIInternational/teehr-cloud-core#69.
RUN groupadd -g 1000 prefect && \
    useradd -u 1000 -g 1000 -m -d /home/prefect prefect

RUN mkdir -p /teehr && mkdir -p /teehr/workflows && chown -R prefect:prefect /teehr

COPY prefect-local.yaml /teehr/prefect-local.yaml

COPY prefect-remote.yaml /teehr/prefect-remote.yaml

COPY workflows/ /teehr/workflows/

# Executor template needed for running spark
RUN mkdir -p /opt/teehr && chown -R prefect:prefect /opt/teehr

COPY executor-pod-template.yaml /opt/teehr/executor-pod-template.yaml

COPY update_job_template.py /opt/teehr/update_job_template.py

COPY pause_deployments.py /opt/teehr/pause_deployments.py

# The COPYs above land as root; hand /teehr back to the runtime user.
RUN chown -R prefect:prefect /teehr /opt/teehr

WORKDIR /teehr

# Run as uid 1000 (see the groupadd/useradd above).
USER prefect
